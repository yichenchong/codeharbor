{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev",
      "displayName": "Development (Debug)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CODEHARBOR_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CODEHARBOR_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "release-tests",
      "displayName": "Release (with tests)",
      "description": "Release build with the C++ tests enabled. Shares build/release with the 'release' preset ON PURPOSE: the release workflow packages out of build/release, so both presets must produce the executable at the same path. Re-running one preset over the other's tree only flips CODEHARBOR_BUILD_TESTS and reconfigures; it never leaves a stale binary behind.",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CODEHARBOR_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "release-tests", "configurePreset": "release-tests" }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "release-tests",
      "configurePreset": "release-tests",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
