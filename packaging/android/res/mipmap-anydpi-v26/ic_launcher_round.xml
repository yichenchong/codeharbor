<?xml version="1.0" encoding="utf-8"?>
<!--
  android:roundIcon in the manifest. It resolves to the same adaptive icon on
  purpose: the launcher's mask already produces the round form, so a separate
  drawing would only be a second thing to keep in sync. The attribute is still
  declared because launchers that ask for roundIcon and do not find it fall back
  to a legacy square raster.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
