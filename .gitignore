# Build output
/build/
/build-*/
/out/
*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.exe

# Release packaging output, produced by .github/workflows/release.yml and by the
# same commands run by hand: `artifact/` is the deployed per-OS tree that the
# deploy tools fill in, `installer/` is where ISCC writes the Windows setup exe.
/artifact/
/installer/

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json
_deps/

# Qt
*.qmlc
*.jsc
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.autosave
.qmake.stash

# Node / web
node_modules/
# Bundler/tsc output for every JS workspace (remote/dist, src/web/*/dist).
# Multi-megabyte generated artifacts: rebuilt with `npm run build`, never committed.
dist/
*.tsbuildinfo
.npm/
.cache/

# Editors
.vscode/
.idea/
*.swp
*~
.DS_Store

# Local runtime / secrets
*.local
*.sqlite
*.sqlite-journal

# Live-gate test fixture: generated sshd host/client keypairs + runtime state.
# NEVER commit these - they are real private keys, regenerated on demand.
tests/live/.fixture/
.env
